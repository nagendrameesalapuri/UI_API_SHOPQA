# Copy to .env and fill in. .env is gitignored; CI reads the same names from the
# Azure DevOps variable group playwright-<env> (linked to Key Vault).

# --- Environment selection ---------------------------------------------------
TEST_ENV=qa                 # dev | qa | uat  -> loads src/config/environments/<TEST_ENV>.env
TARGET=real                 # practice | real

# --- Application under test (defaults come from src/config/environments) ------
# UI_BASE_URL=https://nagendra-shopqa.netlify.app
# API_BASE_URL=https://shopqa-backend.onrender.com

# --- Credentials per role (SECRET) ---------------------------------------------
UI_TEST_ADMIN_EMAIL=
UI_TEST_ADMIN_PASSWORD=
UI_TEST_CUSTOMER_EMAIL=
UI_TEST_CUSTOMER_PASSWORD=
API_TEST_EMAIL=             # customer account used by the API suite
API_TEST_PASSWORD=

# --- AI layer --------------------------------------------------------------------
LLM_PROVIDER=none           # none | azure-openai | anthropic | openai-compatible
# AZURE_OPENAI_ENDPOINT=    # https://<resource>.openai.azure.com
# AZURE_OPENAI_DEPLOYMENT=
# AZURE_OPENAI_API_VERSION=2024-10-21
# AZURE_OPENAI_API_KEY=
# ANTHROPIC_API_KEY=
# ANTHROPIC_MODEL=claude-opus-5
# OPENAI_COMPAT_BASE_URL=   # e.g. http://localhost:11434/v1
# OPENAI_COMPAT_API_KEY=
# OPENAI_COMPAT_MODEL=
# LLM_MAX_CALLS_PER_RUN=20
# LLM_MAX_INPUT_CHARS=12000
# LLM_MAX_OUTPUT_TOKENS=1500
# LLM_BUDGET_USD=1.00
# LLM_PRICE_INPUT_PER_1K=0  # USD per 1k input tokens, for cost logging
# LLM_PRICE_OUTPUT_PER_1K=0
# REDACT_NAMES=             # comma-separated person names to mask before LLM calls

# --- Azure DevOps ------------------------------------------------------------------
ADO_ORG=                    # organisation name (dev.azure.com/<ADO_ORG>)
ADO_PROJECT=
ADO_PAT=                    # local only; pipelines use $(System.AccessToken)
ADO_REPO=                   # repository name, for agent pull requests
ADO_REGRESSION_PIPELINE_ID=
# ADO_AREA_PATH=
# ADO_ITERATION_PATH=
# TEAMS_WEBHOOK_URL=        # optional triage summary to a Teams channel

# --- Dashboard -----------------------------------------------------------------
# DASHBOARD_MOCK=true       # demo the full flow without Azure DevOps
# DASHBOARD_USER=admin      # basic auth for the dashboard server
# DASHBOARD_PASSWORD=
# DASHBOARD_PORT=4300

# --- Optional cloud browsers (Azure Playwright Workspaces) ----------------------
# PLAYWRIGHT_SERVICE_URL=
